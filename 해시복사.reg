Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\*\shell\CopyHash]
"MUIVerb"="해쉬값(SHA256) 복사"
"Icon"="powershell.exe"

[HKEY_CLASSES_ROOT\*\shell\CopyHash\command]
@="powershell.exe -WindowStyle Hidden -Command \"Get-FileHash -Path '%1' -Algorithm SHA256 | Select-Object -ExpandProperty Hash | Set-Clipboard\""
